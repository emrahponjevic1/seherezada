# Kopiraj u .env.local i popuni. .env.local NIKAD ne ide u git.
#
# Korak 24 ovo formalizuje kroz lib/env.ts, koji pada sa jasnom porukom
# ako obavezna varijabla nedostaje.

# Puna adresa sajta — koriste je sitemap, canonical i kasnije hreflang.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Baza ─────────────────────────────────────────────────────
# Dvije uloge namjerno: web SAMO ČITA, admin i piše. Ako javni dio
# sajta ikad pokuša pisati, baza to odbije.
#
# Na serveru se mijenja samo host i lozinke — ostalo ostaje isto.

DATABASE_URL=postgres://seherezada_web:LOZINKA@localhost:5432/seherezada
DATABASE_URL_ADMIN=postgres://seherezada_admin:LOZINKA@localhost:5432/seherezada

# ── Kasniji koraci ───────────────────────────────────────────
# GOOGLE_PLACES_API_KEY=        # korak 21, nikad u pregledniku
# REPO=static                   # 'static' vraća demo podatke bez baze
